---
import SeoMeta from '../components/SeoMeta.astro';
import CategoryNav from '../components/CategoryNav.astro';

export interface Props {
  title?: string;
  description?: string;
  image?: string | null;
  currentCategory?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
}

const {
  title,
  description,
  image,
  currentCategory = 'all',
  type = 'website',
  publishedTime,
} = Astro.props;
---

<!doctype html>
<html lang="bn">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Google Fonts: Hind Siliguri for high-clarity Bengali typography -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <SeoMeta
      title={title}
      description={description}
      image={image}
      type={type}
      publishedTime={publishedTime}
    />
  </head>
  <body>
    <header class="site-header">
      <div class="header-inner">
        <a href="/" class="brand-link">
          <h1 class="brand-title">প্রকাশ</h1>
          <span class="brand-tagline">সংবেদনশীলতাহীন নিরপেক্ষ সংবাদ</span>
        </a>
        <div class="header-actions">
          <a href="/rss.xml" class="rss-link" title="RSS ফিড">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 11a9 9 0 0 1 9 9"></path>
              <path d="M4 4a16 16 0 0 1 16 16"></path>
              <circle cx="5" cy="19" r="1"></circle>
            </svg>
            <span>RSS</span>
          </a>
        </div>
      </div>
    </header>

    <CategoryNav currentCategory={currentCategory} />

    <main class="main-content">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-inner">
        <div class="footer-brand">
          <div class="footer-title">প্রকাশ (Prokash)</div>
          <p class="footer-desc">
            তথ্যভিত্তিক, পক্ষপাতহীন এবং সংবেদনশীলতামুক্ত সংবাদ সারসংক্ষেপ প্ল্যাটফর্ম। মূল সংবাদের সম্পূর্ণ স্বত্ব ও কৃতজ্ঞতা সংশ্লিষ্ট সংবাদমাধ্যমের।
          </p>
        </div>
        <div class="footer-bottom">
          <span>&copy; {new Date().getFullYear()} প্রকাশ। সর্বস্বত্ব সংরক্ষিত।</span>
          <div class="footer-links">
            <a href="/rss.xml">RSS ফিড</a>
            <span class="dot">•</span>
            <a href="https://www.facebook.com/1482028081653288" target="_blank" rel="noopener noreferrer">ফেসবুক পেজ</a>
          </div>
        </div>
      </div>
    </footer>

    <style is:global>
      :root {
        --font-bengali: 'Hind Siliguri', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        --bg-main: #f8fafc;
        --bg-surface: #ffffff;
        --bg-card: #ffffff;
        --text-main: #0f172a;
        --text-body: #334155;
        --text-muted: #64748b;
        --border-color: #e2e8f0;
        --border-hover: #cbd5e1;
        --primary: #0284c7;
        --primary-hover: #0369a1;
        --badge-bg: #e0f2fe;
        --badge-text: #0369a1;
      }

      @media (prefers-color-scheme: dark) {
        :root {
          --bg-main: #0b0f17;
          --bg-surface: #111827;
          --bg-card: #151d2f;
          --text-main: #f1f5f9;
          --text-body: #cbd5e1;
          --text-muted: #94a3b8;
          --border-color: #1e293b;
          --border-hover: #334155;
          --primary: #38bdf8;
          --primary-hover: #7dd3fc;
          --badge-bg: #1e293b;
          --badge-text: #38bdf8;
        }
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        padding: 0;
        background: var(--bg-main);
        color: var(--text-main);
        font-family: var(--font-bengali);
        font-size: 16px;
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
      }

      .site-header {
        background: var(--bg-surface);
        border-bottom: 1px solid var(--border-color);
        padding: 1rem 0;
      }

      .header-inner {
        max-width: 900px;
        margin: 0 auto;
        padding: 0 1rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
      }

      .brand-link {
        text-decoration: none;
        color: inherit;
      }

      .brand-title {
        font-size: 1.85rem;
        font-weight: 700;
        margin: 0;
        letter-spacing: -0.02em;
        color: var(--text-main);
      }

      .brand-tagline {
        font-size: 0.82rem;
        color: var(--text-muted);
        display: block;
        margin-top: 0.1rem;
      }

      .rss-link {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        font-size: 0.85rem;
        font-weight: 600;
        color: var(--text-muted);
        text-decoration: none;
        padding: 0.35rem 0.65rem;
        border: 1px solid var(--border-color);
        border-radius: 6px;
        transition: all 0.15s ease;
      }

      .rss-link:hover {
        color: var(--primary);
        border-color: var(--primary);
      }

      .main-content {
        max-width: 900px;
        margin: 1.5rem auto 3rem auto;
        padding: 0 1rem;
        min-height: 60vh;
      }

      .site-footer {
        background: var(--bg-surface);
        border-top: 1px solid var(--border-color);
        padding: 2.5rem 0 1.5rem 0;
        color: var(--text-muted);
        font-size: 0.9rem;
      }

      .footer-inner {
        max-width: 900px;
        margin: 0 auto;
        padding: 0 1rem;
      }

      .footer-brand {
        margin-bottom: 1.5rem;
      }

      .footer-title {
        font-size: 1.1rem;
        font-weight: 700;
        color: var(--text-main);
        margin-bottom: 0.4rem;
      }

      .footer-desc {
        margin: 0;
        max-width: 600px;
        line-height: 1.6;
        font-size: 0.88rem;
      }

      .footer-bottom {
        border-top: 1px solid var(--border-color);
        padding-top: 1rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.5rem;
        font-size: 0.82rem;
      }

      .footer-links {
        display: flex;
        align-items: center;
        gap: 0.5rem;
      }

      .footer-links a {
        color: var(--text-muted);
        text-decoration: none;
      }

      .footer-links a:hover {
        color: var(--primary);
      }

      .dot {
        color: var(--border-color);
      }
    </style>
  </body>
</html>
