---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import SearchFilter from '../components/SearchFilter.astro';
import { supabase, type Article } from '../lib/supabase';

// Set edge caching headers
Astro.response.headers.set('Cache-Control', 'public, s-maxage=300, stale-while-revalidate=3600');

// Parse search params
const searchQuery = Astro.url.searchParams.get('q') || '';
const categoryFilter = Astro.url.searchParams.get('category') || 'all';
const sourceFilter = Astro.url.searchParams.get('source') || 'all';

let articles: Article[] = [];
let availableSources: string[] = [];
let fetchError: string | null = null;

try {
  // 1. Fetch available sources for the filter dropdown
  const { data: sourcesData } = await supabase
    .from('sources')
    .select('name')
    .eq('is_active', true);
  
  if (sourcesData) {
    availableSources = Array.from(new Set(sourcesData.map((s: any) => s.name)));
  }

  // 2. Query articles with filters
  let query = supabase
    .from('articles')
    .select('*')
    .eq('status', 'published');

  if (categoryFilter && categoryFilter !== 'all') {
    query = query.eq('category', categoryFilter);
  }

  if (sourceFilter && sourceFilter !== 'all') {
    query = query.eq('source_name', sourceFilter);
  }

  if (searchQuery.trim()) {
    query = query.or(`title_bn.ilike.%${searchQuery.trim()}%,summary_bn.ilike.%${searchQuery.trim()}%`);
  }

  const { data, error } = await query
    .order('published_at', { ascending: false })
    .limit(36);

  if (error) {
    fetchError = error.message;
  } else {
    articles = (data as Article[]) || [];
  }
} catch (err: any) {
  fetchError = err.message || 'ডাটাবেজ সংযোগে সমস্যা হয়েছে';
}

const isFiltered = Boolean(searchQuery.trim() || categoryFilter !== 'all' || sourceFilter !== 'all');

// Slice articles for the NYT broadsheet grid
const heroArticle = articles[0];
const subLeadArticles = articles.slice(1, 3);
const rightColArticles = articles.slice(3, 8);
const remainingArticles = articles.slice(8);
---

<BaseLayout
  title="প্রকাশ — সংবেদনশীলতাহীন নিরপেক্ষ সংবাদ"
  description="দৈনিক গুরুত্বপূর্ণ সংবাদের প্রমিত বাংলায় বস্তুনিষ্ঠ ও সংক্ষিপ্ত সারসংক্ষেপ। দ্য নিউ ইয়র্ক টাইমস ধাঁচের মাল্টিকলাম নিউজ প্ল্যাটফর্ম।"
  currentCategory={categoryFilter !== 'all' ? categoryFilter : 'all'}
>
  <!-- Search & Filter Utility Toolbar -->
  <SearchFilter
    searchQuery={searchQuery}
    selectedCategory={categoryFilter}
    selectedSource={sourceFilter}
    availableSources={availableSources}
    totalCount={articles.length}
  />

  {fetchError ? (
    <div class="state-card error-card">
      <h3 class="state-title">সংবাদ লোড করতে সমস্যা হয়েছে</h3>
      <p class="state-desc">{fetchError}</p>
    </div>
  ) : articles.length === 0 ? (
    <div class="state-card empty-card">
      <div class="empty-icon">📰</div>
      <h3 class="state-title">কোনো সংবাদ প্রতিবেদন পাওয়া যায়নি</h3>
      <p class="state-desc">
        {isFiltered 
          ? 'আপনার প্রদত্ত অনুসন্ধানের সাথে কোনো সংবাদ মেলেনি। অনুগ্রহ করে ফিল্টার পরিবর্তন করে পুনরায় চেষ্টা করুন।'
          : 'আমাদের স্বয়ংক্রিয় ইঞ্জিন সংবাদ সংগ্রহ ও প্রক্রিয়াকরণ শুরু করছে। অনুগ্রহ করে কিছুক্ষণ পর পুনরায় পরীক্ষা করুন।'}
      </p>
      {isFiltered && (
        <a href="/" class="reset-filter-cta">সকল সংবাদে ফিরে যান</a>
      )}
    </div>
  ) : isFiltered ? (
    /* Filtered Search Results View: Clean 3-Column Broadsheet Grid */
    <div class="filtered-results-container">
      <div class="section-banner">
        <span class="banner-title">অনুসন্ধান ফলাফল</span>
        <span class="banner-count">({articles.length}টি প্রতিবেদন)</span>
      </div>
      <div class="broadsheet-three-col-grid">
        {articles.map((art) => (
          <div
            class="broadsheet-card-wrap"
            data-title={art.title_bn}
            data-summary={art.summary_bn}
            data-category={art.category}
            data-source={art.source_name}
          >
            <ArticleCard article={art} variant="column" />
          </div>
        ))}
      </div>
    </div>
  ) : (
    /* Classic New York Times Broadsheet Layout */
    <div class="nyt-broadsheet-layout">
      <!-- Top Broadsheet Grid: 7-Col Left Lead + 5-Col Right Dispatches -->
      <section class="broadsheet-hero-section">
        <!-- Left Dominant Column (Hero Story + Sub-leads) -->
        <div class="broadsheet-left-column">
          {heroArticle && (
            <div
              class="broadsheet-card-wrap hero-wrap"
              data-title={heroArticle.title_bn}
              data-summary={heroArticle.summary_bn}
              data-category={heroArticle.category}
              data-source={heroArticle.source_name}
            >
              <ArticleCard article={heroArticle} variant="hero" />
            </div>
          )}

          {subLeadArticles.length > 0 && (
            <div class="sub-leads-two-col-grid">
              {subLeadArticles.map((art) => (
                <div
                  class="broadsheet-card-wrap sub-lead-wrap"
                  data-title={art.title_bn}
                  data-summary={art.summary_bn}
                  data-category={art.category}
                  data-source={art.source_name}
                >
                  <ArticleCard article={art} variant="standard" />
                </div>
              ))}
            </div>
          )}
        </div>

        <!-- Vertical Broadsheet Hairline Divider -->
        <div class="broadsheet-vertical-divider" aria-hidden="true"></div>

        <!-- Right Broadsheet Column (Latest Fast Dispatches & Briefs) -->
        <aside class="broadsheet-right-column">
          <div class="column-header-banner">
            <h3 class="column-header-title">সর্বশেষ সংবাদ ও সারসংক্ষেপ</h3>
            <span class="live-dot" title="লাইভ আপডেট">●</span>
          </div>

          <div class="compact-stories-stream">
            {rightColArticles.map((art) => (
              <div
                class="broadsheet-card-wrap compact-wrap"
                data-title={art.title_bn}
                data-summary={art.summary_bn}
                data-category={art.category}
                data-source={art.source_name}
              >
                <ArticleCard article={art} variant="compact" />
              </div>
            ))}
          </div>
        </aside>
      </section>

      <!-- Section Divider -->
      {remainingArticles.length > 0 && (
        <section class="broadsheet-extended-section">
          <div class="section-banner">
            <span class="banner-rule-line"></span>
            <span class="banner-title">আরও গুরুত্বপূর্ণ প্রতিবেদন ও সারসংক্ষেপ</span>
            <span class="banner-rule-line"></span>
          </div>

          <!-- 3-Column Broadsheet Lower Grid -->
          <div class="broadsheet-three-col-grid">
            {remainingArticles.map((art) => (
              <div
                class="broadsheet-card-wrap"
                data-title={art.title_bn}
                data-summary={art.summary_bn}
                data-category={art.category}
                data-source={art.source_name}
              >
                <ArticleCard article={art} variant="column" />
              </div>
            ))}
          </div>
        </section>
      )}
    </div>
  )}
</BaseLayout>

<style>
  /* Broadsheet Top Multicolumn Layout */
  .broadsheet-hero-section {
    display: grid;
    grid-template-columns: 7fr 1px 5fr;
    gap: 1.75rem;
    margin-bottom: 3rem;
  }

  @media (max-width: 1024px) {
    .broadsheet-hero-section {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .broadsheet-vertical-divider {
      display: none;
    }
  }

  /* Vertical Divider Line */
  .broadsheet-vertical-divider {
    background-color: var(--border-hairline);
    width: 1px;
    height: 100%;
  }

  /* Left Broadsheet Column */
  .broadsheet-left-column {
    display: flex;
    flex-direction: column;
  }

  .hero-wrap {
    margin-bottom: 1.5rem;
  }

  /* Sub-leads Two-Column Grid */
  .sub-leads-two-col-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  @media (max-width: 640px) {
    .sub-leads-two-col-grid {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
  }

  .sub-lead-wrap {
    display: flex;
    flex-direction: column;
  }

  /* Right Broadsheet Column */
  .broadsheet-right-column {
    display: flex;
    flex-direction: column;
  }

  .column-header-banner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 2px solid var(--border-dark);
    padding-bottom: 0.4rem;
    margin-bottom: 1.15rem;
  }

  .column-header-title {
    font-family: var(--font-serif);
    font-size: 1.05rem;
    font-weight: 700;
    margin: 0;
    color: var(--text-headline);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .live-dot {
    color: var(--accent-crimson);
    font-size: 0.75rem;
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0% { opacity: 1; }
    50% { opacity: 0.4; }
    100% { opacity: 1; }
  }

  .compact-stories-stream {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  /* Extended Section */
  .broadsheet-extended-section {
    margin-top: 2rem;
  }

  .section-banner {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.75rem;
  }

  .banner-rule-line {
    flex: 1;
    height: 1px;
    background-color: var(--border-dark);
  }

  .banner-title {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    font-weight: 800;
    color: var(--text-headline);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }

  .banner-count {
    font-size: 0.9rem;
    color: var(--text-muted);
  }

  /* 3-Column Broadsheet Lower Grid */
  .broadsheet-three-col-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  @media (max-width: 900px) {
    .broadsheet-three-col-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.5rem;
    }
  }

  @media (max-width: 600px) {
    .broadsheet-three-col-grid {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
  }

  /* State Card */
  .state-card {
    background: var(--bg-surface);
    border: 1px solid var(--border-hairline);
    border-radius: 4px;
    padding: 3.5rem 1.5rem;
    text-align: center;
    margin: 2rem 0;
  }

  .empty-icon {
    font-size: 2.8rem;
    margin-bottom: 0.75rem;
  }

  .state-title {
    font-family: var(--font-serif);
    font-size: 1.35rem;
    font-weight: 700;
    margin: 0 0 0.5rem 0;
    color: var(--text-headline);
  }

  .state-desc {
    color: var(--text-muted);
    font-size: 0.95rem;
    max-width: 480px;
    margin: 0 auto 1.25rem auto;
  }

  .reset-filter-cta {
    display: inline-block;
    padding: 0.5rem 1.2rem;
    background: var(--text-headline);
    color: var(--bg-surface);
    text-decoration: none;
    border-radius: 4px;
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: 0.9rem;
  }

  .error-card {
    border-color: #fca5a5;
    background: #fef2f2;
    color: #991b1b;
  }
</style>
