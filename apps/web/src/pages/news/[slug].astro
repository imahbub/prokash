---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { supabase, type Article } from '../../lib/supabase';

const { slug } = Astro.params;

Astro.response.headers.set('Cache-Control', 'public, s-maxage=300, stale-while-revalidate=3600');

let article: Article | null = null;
let relatedArticles: Article[] = [];
let fetchError: string | null = null;

try {
  const { data, error } = await supabase
    .from('articles')
    .select('*')
    .eq('slug', slug)
    .eq('status', 'published')
    .single();

  if (error || !data) {
    fetchError = 'সংবাদটি পাওয়া যায়নি';
  } else {
    article = data as Article;

    // Fetch up to 3 other articles for "আরও পড়ুন" (Read Next)
    const { data: related } = await supabase
      .from('articles')
      .select('*')
      .eq('status', 'published')
      .neq('slug', slug)
      .limit(3);
    
    if (related) {
      relatedArticles = related as Article[];
    }
  }
} catch (err: any) {
  fetchError = err.message || 'ডাটাবেজ সংযোগে সমস্যা হয়েছে';
}

if (!article && !fetchError) {
  return Astro.redirect('/404');
}

const categoryLabels: Record<string, string> = {
  national: 'বাংলাদেশ',
  international: 'আন্তর্জাতিক',
  economy: 'অর্থনীতি ও বাণিজ্য',
  tech: 'বিজ্ঞান ও প্রযুক্তি',
  sports: 'খেলাধুলা',
  opinion: 'মতামত ও বিশ্লেষণ',
};

const categoryName = article ? categoryLabels[article.category] || article.category : '';

function formatDate(dateStr: string): string {
  try {
    const d = new Date(dateStr);
    return d.toLocaleDateString('bn-BD', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
      hour: '2-digit',
      minute: '2-digit',
    });
  } catch {
    return dateStr;
  }
}
---

{article ? (
  <BaseLayout
    title={article.title_bn}
    description={article.summary_bn}
    image={article.image_url}
    type="article"
    currentCategory={article.category}
    publishedTime={article.published_at}
  >
    <div class="article-broadsheet-container">
      <article class="nyt-story-article">
        <!-- Breadcrumbs / Kicker -->
        <div class="story-kicker-bar">
          <a href={`/category/${article.category}`} class="kicker-category">
            {categoryName}
          </a>
          <span class="kicker-divider">•</span>
          <span class="kicker-timestamp">{formatDate(article.published_at || article.created_at)}</span>
        </div>

        <!-- Headline -->
        <h1 class="story-headline">{article.title_bn}</h1>

        <!-- Byline / Source Attribution Box -->
        <div class="story-byline-bar">
          <div class="byline-left">
            <span class="byline-author">সংবাদ সংকলন: <strong>প্রকাশ ডেস্ক</strong></span>
            <span class="byline-sep">|</span>
            <span class="byline-source">
              মূল উৎস: <a href={article.original_url} target="_blank" rel="noopener noreferrer nofollow" class="source-link">{article.source_name} ↗</a>
            </span>
          </div>
          <div class="byline-right">
            <button
              onclick="navigator.clipboard.writeText(window.location.href); alert('সংবাদটির লিংক কপি করা হয়েছে!');"
              class="share-link-btn"
              title="লিংক কপি করুন"
            >
              🔗 শেয়ার করুন
            </button>
          </div>
        </div>

        <!-- Main Featured Image -->
        {article.image_url && (
          <figure class="story-featured-figure">
            <img
              src={article.image_url}
              alt={article.title_bn}
              class="story-main-img"
              loading="eager"
              onerror="this.parentElement.style.display='none'"
            />
            <figcaption class="story-caption">
              ছবি: {article.source_name} সৌজন্যে | মূল সংবাদমাধ্যমের স্বত্ব সংরক্ষিত
            </figcaption>
          </figure>
        )}

        <!-- 3-Bullet Key Takeaways Box (Classic NYT Key Points Box) -->
        {Array.isArray(article.bullets_bn) && article.bullets_bn.length > 0 && (
          <section class="story-keypoints-box" aria-label="মূল তথ্যাবলি">
            <div class="keypoints-title">
              <span class="keypoints-bullet">■</span>
              <span>ঘটনার মূল তথ্য ও সারসংক্ষেপ:</span>
            </div>
            <ul class="keypoints-list">
              {article.bullets_bn.map((point: string) => (
                <li>{point}</li>
              ))}
            </ul>
          </section>
        )}

        <!-- Summary Paragraph / Story Body -->
        <div class="story-body-content">
          <p class="story-lead-paragraph">{article.summary_bn}</p>
        </div>

        <!-- Outbound Fair-Use Attribution Callout -->
        <div class="story-outbound-callout">
          <div class="callout-heading">মূল প্রতিবেদন পড়তে:</div>
          <p class="callout-text">
            ঘটনার পূর্ণাঙ্গ পটভূমি, সরাসরি উদ্ধৃতি ও বিস্তারিত বিশ্লেষণের জন্য মূল সংবাদমাধ্যম <strong>{article.source_name}</strong>-এর মূল প্রতিবেদনটি পড়ুন।
          </p>
          <a
            href={article.original_url}
            target="_blank"
            rel="noopener noreferrer nofollow"
            class="callout-cta-btn"
          >
            {article.source_name}-এ পুরো প্রতিবেদন পড়ুন ↗
          </a>
        </div>
      </article>

      <!-- Sidebar / Related Stories -->
      {relatedArticles.length > 0 && (
        <aside class="story-sidebar">
          <div class="sidebar-header">
            <h3 class="sidebar-title">আরও গুরুত্বপূর্ণ সংবাদ</h3>
            <span class="rule"></span>
          </div>
          <div class="sidebar-stories">
            {relatedArticles.map((rel) => (
              <div class="sidebar-card">
                <a href={`/news/${rel.slug}`} class="sidebar-headline">
                  {rel.title_bn}
                </a>
                <div class="sidebar-meta">
                  <span class="source-tag">{rel.source_name}</span>
                </div>
              </div>
            ))}
          </div>
        </aside>
      )}
    </div>
  </BaseLayout>
) : (
  <BaseLayout title="সংবাদটি পাওয়া যায়নি — প্রকাশ">
    <div class="not-found-card">
      <h1>সংবাদটি খুঁজে পাওয়া যায়নি</h1>
      <p>{fetchError || 'অনুরোধকৃত সংবাদটি সরানো হয়েছে অথবা সংযোগে ত্রুটি দেখা দিয়েছে।'}</p>
      <a href="/" class="back-home-link">← হোমপেজে ফিরে যান</a>
    </div>
  </BaseLayout>
)}

<style>
  .article-broadsheet-container {
    display: grid;
    grid-template-columns: minmax(0, 8fr) minmax(0, 4fr);
    gap: 2rem;
    margin-top: 1.25rem;
  }

  @media (max-width: 900px) {
    .article-broadsheet-container {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }

  /* Story Article */
  .nyt-story-article {
    background: var(--bg-surface);
    border: 1px solid var(--border-hairline);
    border-radius: 8px;
    padding: 2.25rem 2.5rem;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.02);
  }

  @media (max-width: 768px) {
    .nyt-story-article {
      padding: 1.35rem 1.15rem;
    }
  }

  .story-kicker-bar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.82rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.75rem;
    color: var(--text-muted);
  }

  .kicker-category {
    color: var(--accent-crimson);
    font-weight: 700;
    text-decoration: none;
  }

  .kicker-divider {
    color: var(--border-hairline);
  }

  .story-headline {
    font-family: var(--font-serif);
    font-size: 2.6rem;
    line-height: 1.25;
    font-weight: 800;
    color: var(--text-headline);
    margin: 0 0 1.25rem 0;
    letter-spacing: -0.02em;
  }

  @media (max-width: 640px) {
    .story-headline {
      font-size: 1.85rem;
    }
  }

  /* Byline */
  .story-byline-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.75rem 0;
    border-top: 1px solid var(--border-hairline);
    border-bottom: 1px solid var(--border-hairline);
    margin-bottom: 1.75rem;
    font-size: 0.85rem;
    color: var(--text-muted);
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .byline-left {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    flex-wrap: wrap;
  }

  .byline-sep {
    color: var(--border-hairline);
  }

  .source-link {
    color: var(--text-ink);
    font-weight: 600;
    text-decoration: none;
  }

  .source-link:hover {
    color: var(--accent-crimson);
    text-decoration: underline;
  }

  .share-link-btn {
    background: var(--bg-subtle);
    border: 1px solid var(--border-hairline);
    color: var(--text-headline);
    padding: 0.35rem 0.75rem;
    font-size: 0.82rem;
    font-weight: 600;
    border-radius: 3px;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .share-link-btn:hover {
    background: var(--border-hairline);
  }

  /* Media */
  .story-featured-figure {
    margin: 0 0 1.75rem 0;
  }

  .story-main-img {
    width: 100%;
    max-height: 480px;
    object-fit: cover;
    display: block;
    border-radius: 6px;
  }

  .story-caption {
    font-size: 0.8rem;
    color: var(--text-muted);
    padding-top: 0.5rem;
    border-bottom: 1px solid var(--border-hairline);
    padding-bottom: 0.5rem;
  }

  /* Key Takeaways Box */
  .story-keypoints-box {
    background: var(--bg-subtle);
    border-left: 3px solid var(--accent-crimson);
    border-radius: 4px;
    padding: 1.25rem 1.5rem;
    margin-bottom: 2rem;
  }

  .keypoints-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--text-headline);
    margin-bottom: 0.75rem;
  }

  .keypoints-bullet {
    color: var(--accent-crimson);
    font-size: 0.8rem;
  }

  .keypoints-list {
    margin: 0;
    padding-left: 1.25rem;
    font-size: 1.02rem;
    line-height: 1.75;
    color: var(--text-body);
  }

  .keypoints-list li {
    margin-bottom: 0.5rem;
  }

  .keypoints-list li:last-child {
    margin-bottom: 0;
  }

  /* Body Content */
  .story-body-content {
    margin-bottom: 2.5rem;
  }

  .story-lead-paragraph {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    line-height: 1.85;
    color: var(--text-ink);
    margin: 0;
  }

  /* Outbound Callout */
  .story-outbound-callout {
    border: 1px solid var(--border-main);
    background: var(--bg-subtle);
    padding: 1.5rem;
    border-radius: 4px;
    margin-bottom: 2rem;
  }

  .callout-heading {
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--text-headline);
    margin-bottom: 0.4rem;
  }

  .callout-text {
    font-size: 0.95rem;
    color: var(--text-body);
    margin: 0 0 1rem 0;
    line-height: 1.6;
  }

  .callout-cta-btn {
    display: inline-block;
    padding: 0.6rem 1.25rem;
    background: var(--text-headline);
    color: var(--bg-surface);
    text-decoration: none;
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: 0.92rem;
    border-radius: 3px;
    transition: opacity 0.15s ease;
  }

  .callout-cta-btn:hover {
    opacity: 0.9;
  }

  /* Sidebar */
  .story-sidebar {
    background: var(--bg-surface);
    border: 1px solid var(--border-hairline);
    border-radius: 8px;
    padding: 1.75rem 1.5rem;
    height: fit-content;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.02);
  }

  @media (max-width: 900px) {
    .story-sidebar {
      margin-top: 1rem;
      padding: 1.5rem 1.25rem;
    }
  }

  .sidebar-header {
    margin-bottom: 1.25rem;
    border-bottom: 2px solid var(--border-dark);
    padding-bottom: 0.4rem;
  }

  .sidebar-title {
    font-family: var(--font-serif);
    font-size: 1.05rem;
    font-weight: 800;
    color: var(--text-headline);
    margin: 0;
    text-transform: uppercase;
  }

  .sidebar-stories {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .sidebar-card {
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--border-hairline);
  }

  .sidebar-card:last-child {
    border-bottom: none;
  }

  .sidebar-headline {
    font-family: var(--font-serif);
    font-size: 1.08rem;
    line-height: 1.4;
    font-weight: 700;
    color: var(--text-headline);
    text-decoration: none;
    display: block;
    margin-bottom: 0.4rem;
  }

  .sidebar-headline:hover {
    color: var(--accent-crimson);
  }

  .sidebar-meta {
    font-size: 0.78rem;
    color: var(--text-muted);
  }

  .not-found-card {
    background: var(--bg-surface);
    border: 1px solid var(--border-hairline);
    border-radius: 4px;
    padding: 4rem 1.5rem;
    text-align: center;
  }

  .back-home-link {
    display: inline-block;
    margin-top: 1rem;
    color: var(--accent-crimson);
    font-weight: 700;
    text-decoration: none;
  }
</style>
