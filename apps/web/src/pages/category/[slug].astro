---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import SearchFilter from '../../components/SearchFilter.astro';
import { supabase, type Article } from '../../lib/supabase';

const { slug } = Astro.params;

const categoryLabels: Record<string, string> = {
  national: 'বাংলাদেশ',
  international: 'আন্তর্জাতিক',
  economy: 'অর্থনীতি ও বাণিজ্য',
  tech: 'বিজ্ঞান ও প্রযুক্তি',
  sports: 'খেলাধুলা',
  opinion: 'মতামত ও বিশ্লেষণ',
};

const categoryName = categoryLabels[slug || ''] || 'সংবাদ';

// Set edge caching headers
Astro.response.headers.set('Cache-Control', 'public, s-maxage=300, stale-while-revalidate=3600');

let articles: Article[] = [];
let availableSources: string[] = [];
let fetchError: string | null = null;

try {
  const { data: sourcesData } = await supabase
    .from('sources')
    .select('name')
    .eq('is_active', true);
  
  if (sourcesData) {
    availableSources = Array.from(new Set(sourcesData.map((s: any) => s.name)));
  }

  const { data, error } = await supabase
    .from('articles')
    .select('*')
    .eq('category', slug)
    .eq('status', 'published')
    .order('published_at', { ascending: false })
    .limit(30);

  if (error) {
    fetchError = error.message;
  } else {
    articles = (data as Article[]) || [];
  }
} catch (err: any) {
  fetchError = err.message || 'ডাটাবেজ সংযোগে সমস্যা হয়েছে';
}

const heroArticle = articles[0];
const subLeadArticles = articles.slice(1, 3);
const rightColArticles = articles.slice(3, 7);
const remainingArticles = articles.slice(7);
---

<BaseLayout
  title={`${categoryName} — প্রকাশ`}
  description={`${categoryName} বিভাগের সর্বশেষ বস্তুনিষ্ঠ সংবাদের সংক্ষেপ।`}
  currentCategory={slug}
>
  <SearchFilter
    selectedCategory={slug}
    availableSources={availableSources}
    totalCount={articles.length}
  />

  <div class="category-header-banner">
    <span class="banner-line"></span>
    <h1 class="category-heading">{categoryName}</h1>
    <span class="banner-line"></span>
  </div>

  {fetchError ? (
    <div class="state-card error-card">
      <h3 class="state-title">সংবাদ লোড করতে সমস্যা হয়েছে</h3>
      <p class="state-desc">{fetchError}</p>
    </div>
  ) : articles.length === 0 ? (
    <div class="state-card empty-card">
      <div class="empty-icon">📂</div>
      <h3 class="state-title">{categoryName} বিভাগে এখনও কোনো সংবাদ নেই</h3>
      <p class="state-desc">নতুন সংবাদ সংগৃহীত হলে এখানে স্বয়ংক্রিয়ভাবে প্রকাশিত হবে।</p>
      <a href="/" class="reset-filter-cta">সকল সংবাদে ফিরে যান</a>
    </div>
  ) : (
    <div class="nyt-broadsheet-layout">
      <!-- Top Broadsheet Grid -->
      <section class="broadsheet-hero-section">
        <div class="broadsheet-left-column">
          {heroArticle && (
            <div
              class="broadsheet-card-wrap hero-wrap"
              data-title={heroArticle.title_bn}
              data-summary={heroArticle.summary_bn}
              data-category={heroArticle.category}
              data-source={heroArticle.source_name}
            >
              <ArticleCard article={heroArticle} variant="hero" />
            </div>
          )}

          {subLeadArticles.length > 0 && (
            <div class="sub-leads-two-col-grid">
              {subLeadArticles.map((art) => (
                <div
                  class="broadsheet-card-wrap"
                  data-title={art.title_bn}
                  data-summary={art.summary_bn}
                  data-category={art.category}
                  data-source={art.source_name}
                >
                  <ArticleCard article={art} variant="standard" />
                </div>
              ))}
            </div>
          )}
        </div>

        <div class="broadsheet-vertical-divider" aria-hidden="true"></div>

        <aside class="broadsheet-right-column">
          <div class="column-header-banner">
            <h3 class="column-header-title">{categoryName} সংক্ষেপ</h3>
            <span class="live-dot">●</span>
          </div>

          <div class="compact-stories-stream">
            {rightColArticles.map((art) => (
              <div
                class="broadsheet-card-wrap"
                data-title={art.title_bn}
                data-summary={art.summary_bn}
                data-category={art.category}
                data-source={art.source_name}
              >
                <ArticleCard article={art} variant="compact" />
              </div>
            ))}
          </div>
        </aside>
      </section>

      <!-- Remaining Articles 3-Col Grid -->
      {remainingArticles.length > 0 && (
        <section class="broadsheet-extended-section">
          <div class="section-banner">
            <span class="banner-rule-line"></span>
            <span class="banner-title">আরও {categoryName} সংবাদ</span>
            <span class="banner-rule-line"></span>
          </div>

          <div class="broadsheet-three-col-grid">
            {remainingArticles.map((art) => (
              <div
                class="broadsheet-card-wrap"
                data-title={art.title_bn}
                data-summary={art.summary_bn}
                data-category={art.category}
                data-source={art.source_name}
              >
                <ArticleCard article={art} variant="column" />
              </div>
            ))}
          </div>
        </section>
      )}
    </div>
  )}
</BaseLayout>

<style>
  .category-header-banner {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  .banner-line {
    flex: 1;
    height: 1px;
    background-color: var(--border-dark);
  }

  .category-heading {
    font-family: var(--font-serif);
    font-size: 1.85rem;
    font-weight: 800;
    color: var(--text-headline);
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    white-space: nowrap;
  }

  /* Broadsheet Grid */
  .broadsheet-hero-section {
    display: grid;
    grid-template-columns: 7fr 1px 5fr;
    gap: 1.75rem;
    margin-bottom: 3rem;
  }

  @media (max-width: 1024px) {
    .broadsheet-hero-section {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .broadsheet-vertical-divider {
      display: none;
    }
  }

  .broadsheet-vertical-divider {
    background-color: var(--border-hairline);
    width: 1px;
    height: 100%;
  }

  .broadsheet-left-column {
    display: flex;
    flex-direction: column;
  }

  .hero-wrap {
    margin-bottom: 1.5rem;
  }

  .sub-leads-two-col-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  @media (max-width: 640px) {
    .sub-leads-two-col-grid {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
  }

  .broadsheet-right-column {
    display: flex;
    flex-direction: column;
  }

  .column-header-banner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 2px solid var(--border-dark);
    padding-bottom: 0.4rem;
    margin-bottom: 1.15rem;
  }

  .column-header-title {
    font-family: var(--font-serif);
    font-size: 1.05rem;
    font-weight: 700;
    margin: 0;
    color: var(--text-headline);
    text-transform: uppercase;
  }

  .live-dot {
    color: var(--accent-crimson);
    font-size: 0.75rem;
  }

  .compact-stories-stream {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .broadsheet-extended-section {
    margin-top: 2rem;
  }

  .section-banner {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.75rem;
  }

  .banner-rule-line {
    flex: 1;
    height: 1px;
    background-color: var(--border-dark);
  }

  .banner-title {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    font-weight: 800;
    color: var(--text-headline);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }

  .broadsheet-three-col-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  @media (max-width: 900px) {
    .broadsheet-three-col-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .broadsheet-three-col-grid {
      grid-template-columns: 1fr;
    }
  }

  .state-card {
    background: var(--bg-surface);
    border: 1px solid var(--border-hairline);
    border-radius: 4px;
    padding: 3.5rem 1.5rem;
    text-align: center;
    margin: 2rem 0;
  }

  .empty-icon {
    font-size: 2.8rem;
    margin-bottom: 0.75rem;
  }

  .state-title {
    font-family: var(--font-serif);
    font-size: 1.35rem;
    font-weight: 700;
    margin: 0 0 0.5rem 0;
    color: var(--text-headline);
  }

  .state-desc {
    color: var(--text-muted);
    font-size: 0.95rem;
    max-width: 480px;
    margin: 0 auto 1.25rem auto;
  }

  .reset-filter-cta {
    display: inline-block;
    padding: 0.5rem 1.2rem;
    background: var(--text-headline);
    color: var(--bg-surface);
    text-decoration: none;
    border-radius: 4px;
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: 0.9rem;
  }

  .error-card {
    border-color: #fca5a5;
    background: #fef2f2;
    color: #991b1b;
  }
</style>
